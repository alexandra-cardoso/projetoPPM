<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" prefHeight="500.0" prefWidth="500.0"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="MenuController" style="-fx-background-color: #f4f4f4; -fx-padding: 40;">
    <children>
        <Label text="Bem-vindo ao Kōnane!" style="-fx-font-size: 26px; -fx-font-weight: bold;" />
        <Label text="Escolhe a dificuldade:" style="-fx-font-size: 16px;" />

        <HBox alignment="CENTER" spacing="10">
            <RadioButton fx:id="rbFacil"  text="Fácil"   onAction="#selecionarFacil"  selected="true"/>
            <Button text="?" onAction="#explicarFacil"  style="-fx-font-size:11px;" prefWidth="24"/>
        </HBox>
        <HBox alignment="CENTER" spacing="10">
            <RadioButton fx:id="rbMedio"  text="Médio"   onAction="#selecionarMedio"/>
            <Button text="?" onAction="#explicarMedio"  style="-fx-font-size:11px;" prefWidth="24"/>
        </HBox>
        <HBox alignment="CENTER" spacing="10">
            <RadioButton fx:id="rbDificil" text="Difícil" onAction="#selecionarDificil"/>
            <Button text="?" onAction="#explicarDificil" style="-fx-font-size:11px;" prefWidth="24"/>
        </HBox>

        <Label fx:id="lblExplicacao" text="" wrapText="true" maxWidth="400"
               alignment="CENTER" style="-fx-font-size:13px; -fx-text-fill: #555; -fx-font-style: italic;" />

        <HBox alignment="CENTER" spacing="20.0">
            <Button text="Jogar" onAction="#handleSim"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size:15px;"
                    prefWidth="100"/>
            <Button text="Sair" onAction="#handleNao"
                    style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size:15px;"
                    prefWidth="100"/>
        </HBox>
    </children>
</VBox>