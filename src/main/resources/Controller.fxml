               <Pane id="cell52" fx:id="cell52" onMouseClicked="#handleCellClick" GridPane.rowIndex="5" GridPane.columnIndex="2" />
               <Pane id="cell53" fx:id="cell53" onMouseClicked="#handleCellClick" GridPane.rowIndex="5" GridPane.columnIndex="3" />
